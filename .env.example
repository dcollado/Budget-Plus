# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# --- Base de datos (en .env.local: SIEMPRE el proyecto de DESARROLLO) ---
DATA_BACKEND=postgres
DATABASE_URL=postgresql://postgres.<proyecto-dev>:<contraseña>@<host>.pooler.supabase.com:6543/postgres
DATABASE_ENV=development

# --- Sesión y URLs ---
SESSION_SECRET=
APP_URL=http://localhost:3000

# --- Solo con next dev: entra solo como este usuario (npm run db:seed-dev los imprime) ---
DEV_AUTO_LOGIN_ID=dev-david
DEV_AUTO_LOGIN_USER=david-dev

# --- Correo (sin esto, en desarrollo los correos salen por consola) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Google (Calendar y modo hoja heredado) ---
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- Respaldo (npm run respaldo) ---
RESPALDO_AVISO_A=
